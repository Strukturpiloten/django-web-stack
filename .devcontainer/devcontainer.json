{
  "name": "Django Web Stack template",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/django-web-stack,type=bind",
  "workspaceFolder": "/workspaces/django-web-stack",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "containerEnv": {
    "UV_PYTHON_DOWNLOADS": "0",
    "UV_LINK_MODE": "copy",
    "UV_CACHE_DIR": "/home/vscode/.cache/uv"
  },
  "postCreateCommand": "bash .devcontainer/verify-tools.sh",
  "waitFor": "postCreateCommand",
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb",
    "storage": "12gb"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "charliermarsh.ruff",
        "redhat.vscode-yaml",
        "esbenp.prettier-vscode",
        "DavidAnson.vscode-markdownlint",
        "tombi-toml.tombi",
        "exiasr.hadolint",
        "mkhl.shfmt",
        "timonwong.shellcheck",
        "streetsidesoftware.code-spell-checker"
      ]
    }
  },
  "runArgs": [
    "--userns=keep-id",
    "--security-opt=label=disable"
  ],
  "mounts": [
    "source=django-web-stack-venv-${devcontainerId},target=/workspaces/django-web-stack/.venv,type=volume",
    "source=django-web-stack-uv-${devcontainerId},target=/home/vscode/.cache/uv,type=volume"
  ]
}
