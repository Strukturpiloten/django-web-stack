{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Application: Uvicorn",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "{{ python_package }}.asgi:application",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${config:python.envFile}",
      "env": {
        "DJANGO_SETTINGS_MODULE": "{{ python_package }}.settings"
      },
      "django": true,
      "justMyCode": true
    },
    {
      "name": "Application: Django runserver",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": [
        "runserver",
        "0.0.0.0:8000",
        "--noreload"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${config:python.envFile}",
      "django": true,
      "justMyCode": true
    },
    {
      "name": "Application: Debug tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "tests",
        "-x"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${config:python.envFile}",
      "justMyCode": true
    }
  ]
}
