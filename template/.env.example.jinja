# Local development defaults. Copy to .env; keep real credentials out of Git.
DJANGO_MODE={{ default_mode }}
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=local-demo-change-this-before-deployment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web,devcontainer
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_ENABLE_ADMIN={{ 1 if include_frontend else 0 }}
DJANGO_ENABLE_API_DOCS={{ 1 if include_frontend else 0 }}
DJANGO_ENABLE_API_SCHEMA=1
DJANGO_ENABLE_SIGNUP=0
# Add provider configuration using the django-allauth social-apps JSON shape.
DJANGO_OIDC_APPS=[]

# Host Python commands use published ports; Compose sets internal service names.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432
POSTGRES_DB={{ python_package }}
POSTGRES_USER=localdemo
POSTGRES_PASSWORD=localdemo
POSTGRES_PUBLISHED_PORT=15432
RABBITMQ_USER=localdemo
RABBITMQ_PASSWORD=localdemo
RABBITMQ_PUBLISHED_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
CELERY_BROKER_URL=amqp://localdemo:localdemo@127.0.0.1:5672//
WEB_PORT=8000
APP_IMAGE_TAG=local

# Optional cache: enable both lines for the Compose Valkey profile.
# COMPOSE_PROFILES=valkey
# CONTAINER_VALKEY_URL=redis://valkey:6379/0
# VALKEY_URL=redis://127.0.0.1:16379/0
VALKEY_PUBLISHED_PORT=16379

# Leave unset to disable exporting traces; no telemetry backend is started.
OTEL_SERVICE_NAME={{ project_slug }}
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
