@pytest.mark.django_db
@pytest.mark.skipif(not settings.API_ENABLED, reason="API disabled")
def test_external_client_can_run_its_own_job_and_revoke_session(owner, django_user_model):
    client = Client(enforce_csrf_checks=True)
    response = client.post(
        "/_allauth/app/v1/auth/login",
        {"username": owner.username, "password": "test-password"},
        content_type="application/json",
    )
    assert response.status_code == 200
    headers = {"X-Session-Token": response.json()["meta"]["session_token"]}
    client = Client(enforce_csrf_checks=True, headers=headers)
    with patch("{{ python_package }}.tasks.run_hello_job.delay"):
        response = client.post("/api/v1/jobs")
    assert response.status_code == 202
    path = f"/api/v1/jobs/{response.json()['id']}"
    assert client.get(path).status_code == 200
    other = django_user_model.objects.create_user(username="other")
    foreign_job = HelloJob.objects.create(owner=other)
    assert client.get(f"/api/v1/jobs/{foreign_job.id}").status_code == 404
    client.delete("/_allauth/app/v1/auth/session")
    assert client.get(path).status_code == 401
