{% if include_frontend %}
FROM docker.io/library/node:24.22.3-trixie-slim@sha256:af02d57b57719b9657a45199a79264a9437940cd55b3c7b3fc99615654f124a0 AS assets
WORKDIR /build
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY assets ./assets
COPY scripts ./scripts
COPY src ./src
COPY pyproject.toml ./
RUN npm run build
{% endif %}

FROM ghcr.io/astral-sh/uv:0.13.9@sha256:d3b601f0c7b118bc1753febf7c41cc80981df678445e0254284eecf84db79a7d AS uv_toolchain
FROM docker.io/library/python:3.15.2-slim-trixie@sha256:65a65fc7b30b06cb6df4930fd4650697cb23f4c2698ab81fc87e4b031bc36928 AS builder
COPY --from=uv_toolchain /uv /uvx /usr/local/bin/
ENV UV_PYTHON_DOWNLOADS=0 \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --all-extras --no-dev --no-install-project
COPY README.md LICENSE ./
COPY src ./src
{% if include_frontend %}
COPY --from=assets /build/src/{{ python_package }}/static/{{ python_package }} ./src/{{ python_package }}/static/{{ python_package }}
{% endif %}
RUN uv sync --locked --all-extras --no-dev --no-editable \
    && DJANGO_SETTINGS_MODULE={{ python_package }}.settings \
       DJANGO_SECRET_KEY=build-only-collectstatic-key \
       DJANGO_DEBUG=1 \
       DJANGO_ENABLE_ADMIN=1 \
       DJANGO_STATIC_ROOT=/app/staticfiles \
       /app/.venv/bin/python -m django collectstatic --noinput

FROM docker.io/library/python:3.15.2-slim-trixie@sha256:65a65fc7b30b06cb6df4930fd4650697cb23f4c2698ab81fc87e4b031bc36928 AS runtime
ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DJANGO_SETTINGS_MODULE={{ python_package }}.settings \
    DJANGO_STATIC_ROOT=/app/staticfiles
RUN groupadd --gid 10001 app \
    && useradd --uid 10001 --gid app --create-home --shell /usr/sbin/nologin app
WORKDIR /app
COPY --from=builder --chown=app:app /app/.venv /app/.venv
COPY --from=builder --chown=app:app /app/staticfiles /app/staticfiles
COPY scripts/container-entrypoint.sh /usr/local/bin/container-entrypoint.sh
RUN chmod 0755 /usr/local/bin/container-entrypoint.sh
USER app
EXPOSE 8000
ENTRYPOINT ["/usr/local/bin/container-entrypoint.sh"]
CMD ["uvicorn", "{{ python_package }}.asgi:application", "--host", "0.0.0.0", "--port", "8000"]
